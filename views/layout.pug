mixin badgeEstado(estado)
  - const est = String(estado || 'confirmado').toLowerCase()
  - const danger = ['no_show', 'cancelacion_tardia', 'cancelado', 'vencido', 'rechazado', 'rechazada', 'fallido'].includes(est)
  - const ok = ['completado', 'activo', 'aprobado', 'aprobada', 'confirmado', 'enviado'].includes(est)
  - const warn = ['pendiente', 'en_atencion', 'congelado', 'agotado', 'reintento'].includes(est)
  - const cls = danger ? 'tf-badge--danger' : ok ? 'tf-badge--ok' : warn ? 'tf-badge--warn' : 'tf-badge--info'
  - const etiquetas = { pendiente: 'Pendiente', confirmado: 'Confirmado', cancelado: 'Cancelado', cancelacion_tardia: 'Cancelación tardía', en_atencion: 'En atención', completado: 'Completado', no_show: 'No-show', activo: 'Activo', congelado: 'Congelado', agotado: 'Agotado', vencido: 'Vencido', aprobado: 'Aprobado', aprobada: 'Aprobada', rechazado: 'Rechazado', rechazada: 'Rechazada', enviado: 'Enviado' }
  span.tf-badge(class=cls)= etiquetas[est] || est.replace(/_/g, ' ')

doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title AutoBox · TurnoFlex
    link(rel="stylesheet" href="/css/styles.css")

  body
    .app
      aside.sidebar
        .sidebar__logo
          img(src="/img/autobox-logo.png" alt="AutoBox")

        nav.sidebar__nav
          if !permisos || permisos.inicio
            a(href="/")
              svg.nav-icon(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                path(d="M3 11L12 4l9 7")
                path(d="M5 10v10h14V10")
                path(d="M9 20v-6h6v6")
              span= usuario && usuario.rol === 'cliente' ? 'Mi panel' : 'Inicio'

          if !permisos || permisos.clientes
            a(href="/clientes")
              svg.nav-icon(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                circle(cx="12" cy="8" r="4")
                path(d="M4 21c0-4 3.5-7 8-7s8 3 8 7")
              span Clientes

          if !permisos || permisos.vehiculos
            a(href="/vehiculos")
              svg.nav-icon(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                path(d="M5 17h14")
                path(d="M6 17l-1-5 2-5h10l2 5-1 5")
                circle(cx="7" cy="17" r="2")
                circle(cx="17" cy="17" r="2")
              span Vehículos

          if !permisos || permisos.turnos
            a(href="/turnos")
              svg.nav-icon(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                rect(x="3" y="5" width="18" height="16" rx="2")
                path(d="M16 3v4M8 3v4M3 10h18")
                path(d="M8 14h2M12 14h2M16 14h2M8 17h2M12 17h2")
              span= usuario && usuario.rol === 'cliente' ? 'Mis turnos' : 'Turnos'

          if permisos && permisos.packs
            a(href="/packs")
              svg.nav-icon(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                path(d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z")
                polyline(points="3.27 6.96 12 12.01 20.73 6.96")
                line(x1="12" y1="22.08" x2="12" y2="12")
              span Packs y créditos

          if permisos && permisos.recepcion
            a(href="/recepcion")
              svg.nav-icon(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                path(d="M9 11l3 3L22 4")
                path(d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11")
              span Recepción

          if permisos && permisos.taller
            a(href="/taller")
              svg.nav-icon(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                path(d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z")
              span= usuario && usuario.rol === 'mecanico' ? 'Mis trabajos' : 'Taller'

          if permisos && permisos.coordinacion
            a(href="/coordinacion")
              svg.nav-icon(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                circle(cx="12" cy="12" r="3")
                path(d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z")
              span Coordinación

          if permisos && permisos.liquidaciones
            a(href="/liquidaciones")
              svg.nav-icon(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                line(x1="12" y1="1" x2="12" y2="23")
                path(d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6")
              span Liquidaciones

          if permisos && permisos.dashboard
            a(href="/dashboard")
              svg.nav-icon(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                line(x1="18" y1="20" x2="18" y2="10")
                line(x1="12" y1="20" x2="12" y2="4")
                line(x1="6" y1="20" x2="6" y2="14")
              span= usuario && usuario.rol === 'recepcion' ? 'Indicadores' : 'Dashboard'

          if permisos && permisos.auditoria
            a(href="/auditoria")
              svg.nav-icon(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                path(d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z")
              span Auditoría

          if permisos && permisos.usuarios
            a(href="/usuarios")
              svg.nav-icon(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                path(d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2")
                circle(cx="8.5" cy="7" r="4")
                line(x1="20" y1="8" x2="20" y2="14")
                line(x1="23" y1="11" x2="17" y2="11")
              span Usuarios

          if usuario
            a(href="/ayuda")
              svg.nav-icon(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                circle(cx="12" cy="12" r="10")
                path(d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3")
                line(x1="12" y1="17" x2="12.01" y2="17")
              span Ayuda / FAQ

          if usuario
            a(href="/logout")
              svg.nav-icon(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                path(d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4")
                polyline(points="16 17 21 12 16 7")
                line(x1="21" y1="12" x2="9" y2="12")
              span Cerrar sesión
          else
            a(href="/login")
              svg.nav-icon(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                path(d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4")
                polyline(points="10 17 15 12 10 7")
                line(x1="15" y1="12" x2="3" y2="12")
              span Iniciar sesión

        .sidebar__footer
          if usuario
            - const etiquetasRol = { admin: 'Administrador', operador: 'Operador', recepcion: 'Recepción', mecanico: 'Mecánico', coordinador: 'Jefe de taller', gerencia: 'Gerencia general', cliente: 'Cliente' }
            p= etiquetasRol[usuario.rol] || 'Sesión activa'
            strong= usuario.nombre
          else
            p Tu vehículo
            strong EN BUENAS MANOS

      .contenido
        block contenido

    // ==========================================
    // WIDGET FLOTANTE: ASESOR IA AUTOBOX
    // ==========================================
    if usuario
      .ia-widget-container
        // Botón circular flotante
        button.ia-widget-toggle#btnToggleChatIA(type="button" title="Consultar Asesor IA")
          svg.ia-icon-open(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
            path(d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z")
          svg.ia-icon-close(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
            line(x1="18" y1="6" x2="6" y2="18")
            line(x1="6" y1="6" x2="18" y2="18")

        // Ventana emergente del chat
        .ia-widget-window#ventanaChatIA.ia-hidden
          .ia-widget-header
            .ia-widget-status
              span.status-dot
              span AutoBox Asesor IA
            button.ia-btn-close#btnCerrarChatIA(type="button") ×

          .chat-box#chatBox
            .chat-msg.chat-msg--bot
              .chat-msg__bubble
                p ¡Hola! Soy el asesor técnico de 
                  strong AutoBox
                  | . ¿En qué podemos ayudarte hoy con tu vehículo?

          form#formChatIA.chat-form
            .chat-form__group
              input#inputPreguntaIA(
                type="text"
                placeholder="Escribí tu consulta técnica..."
                autocomplete="off"
                required
              )
              button.btn.btn--primary#btnEnviarIA(type="submit")
                svg(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16")
                  line(x1="22" y1="2" x2="11" y2="13")
                  polygon(points="22 2 15 22 11 13 2 9 22 2")

    // Scripts
    if socketsHabilitados
      script(src="/socket.io/socket.io.js")
    script(src="/js/main.js")
