extends layout

block contenido

  h2 Nuevo vehículo

  p Complete los datos para registrar un vehículo.

  form(action="/vehiculos" method="POST")

    .campo
      label(for="patente") Patente
      input(
        type="text"
        id="patente"
        name="patente"
        placeholder="Ej: AB 123 CD"
        required
      )

    .campo
      label(for="marca") Marca
      input(
        type="text"
        id="marca"
        name="marca"
        required
      )

    .campo
      label(for="modelo") Modelo
      input(
        type="text"
        id="modelo"
        name="modelo"
        required
      )

    .campo
      label(for="anio") Año
      input(
        type="number"
        id="anio"
        name="anio"
        min="1950"
        max="2100"
        value="2020"
      )

    .campo
      label(for="clienteId") Cliente

      select(
        id="clienteId"
        name="clienteId"
        required
      )
        option(value="" disabled selected) Seleccione un cliente

        each cliente in clientes
          option(value=cliente._id) #{cliente.nombre} #{cliente.apellido}#{cliente.empresa ? ` (${cliente.empresa})` : ''}

    button.boton(type="submit") Registrar vehículo

  a.volver(href="/vehiculos") Volver a vehículos
