extends layout

block contenido

  h2 Nuevo cliente

  p Complete los datos para registrar un cliente particular o flota.

  form(action="/clientes" method="POST")

    .campo
      label(for="nombre") Nombre
      input(
        type="text"
        id="nombre"
        name="nombre"
        minlength="2"
        required
      )

    .campo
      label(for="apellido") Apellido
      input(
        type="text"
        id="apellido"
        name="apellido"
        minlength="2"
        required
      )

    .campo
      label(for="tipo") Tipo de cliente
      select#tipo(name="tipo")
        option(value="particular" selected) Particular
        option(value="flota") Flota corporativa

    .campo#campoEmpresa
      label(for="empresa") Empresa (opcional / para flotas)
      input(
        type="text"
        id="empresa"
        name="empresa"
        placeholder="Ej: Distribuidora ABC"
      )

    .campo
      label(for="telefono") Teléfono
      input(
        type="tel"
        id="telefono"
        name="telefono"
        minlength="7"
        maxlength="20"
        required
      )

    .campo
      label(for="email") Email
      input(
        type="email"
        id="email"
        name="email"
        required
      )

    button.boton(type="submit") Registrar cliente

  a.volver(href="/clientes") Volver a clientes
